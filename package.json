{
  "name": "faith-app",
  "main": "index.js",
  "version": "2.0.2",
  "scripts": {
    "eas-build-pre-install": "npm run version:sync",
    "start": "expo start",
    "android": "node scripts/with-android-build-env.js expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test:admin": "tsx scripts/test-admin-analytics.ts",
    "build:ios": "eas build --platform ios --profile testflight --auto-submit",
    "build:android": "eas build --platform android --profile production",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:preview": "eas build --platform all --profile preview",
    "build:testflight": "eas build --platform ios --profile testflight --auto-submit",
    "version:sync": "node -e \"const a=require('./app.json'); const v=a.expo.version; const p=require('./package.json'); p.version=v; require('fs').writeFileSync('package.json', JSON.stringify(p,null,2)); require('fs').writeFileSync('VERSION.md', v);\"",
    "version:sync-to-app": "node -e \"const p=require('./package.json'); const v=p.version; const a=require('./app.json'); a.expo.version=v; require('fs').writeFileSync('app.json', JSON.stringify(a,null,2)); require('fs').writeFileSync('VERSION.md', v);\"",
    "version:bump:patch": "npm version patch --no-git-tag-version && npm run version:sync-to-app",
    "version:bump:minor": "npm version minor --no-git-tag-version && npm run version:sync-to-app",
    "version:bump:major": "npm version major --no-git-tag-version && npm run version:sync-to-app",
    "version:set:android": "eas build:version:set -p android -e production",
    "version:set:ios": "eas build:version:set -p ios -e testflight",
    "generate:splash": "tsx scripts/generate-splash-branded.ts",
    "supabase:restart": "supabase stop && supabase start"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/html-elements": "^0.10.1",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^3.0.12",
    "@gluestack-ui/utils": "^3.0.15",
    "@legendapp/motion": "^2.5.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/query-persist-client-core": "^5.91.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "expo": "~56.0.15",
    "expo-auth-session": "~56.0.15",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.20",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.14",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.21",
    "expo-splash-screen": "~56.0.12",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.5",
    "i18n-js": "^4.5.2",
    "lottie-react-native": "~7.3.1",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-aria": "^3.46.0",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-color-matrix-image-filters": "^8.0.2",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "react-stately": "^3.44.0",
    "storyblok": "^4.15.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
