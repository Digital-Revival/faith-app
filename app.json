{
  "expo": {
    "name": "Faith Generation",
    "slug": "faith-generation",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo_icon.png",
    "scheme": "faithapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "11",
      "supportsTablet": true,
      "bundleIdentifier": "com.tt.faithGeneration",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "S92GAYN59Q"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo_icon.png"
      },
      "userInterfaceStyle": "automatic",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.trinixInteractive.faith_generation",
      "versionCode": 32,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "faithapp",
              "host": "reset-password"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withAndroidBuildFix.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "ios": {
            "image": "./assets/images/splash_branded.png",
            "resizeMode": "cover",
            "backgroundColor": "#000000",
            "enableFullScreenImage_legacy": true,
            "dark": {
              "image": "./assets/images/splash_branded.png",
              "backgroundColor": "#000000"
            }
          },
          "android": {
            "image": "./assets/images/splash_branded.png",
            "resizeMode": "cover",
            "backgroundColor": "#000000",
            "imageWidth": 288,
            "dark": {
              "image": "./assets/images/splash_branded.png",
              "backgroundColor": "#000000"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Faith Generation to access your photos to set a profile picture."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-sharing",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2785d9c7-4b40-4e13-8474-c788ce872f6e"
      }
    },
    "owner": "alilas"
  }
}
