EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Moet overeenkomen met api.external_url in supabase/config.toml
# Voorbeeld: 192.168.1.50 → external_url = "http://192.168.1.50:54321"
EXPO_PUBLIC_LOCAL_DEV_IP=

EXPO_PUBLIC_STORYBLOK_ACCESS_TOKEN=

EXPO_PUBLIC_VIMEO_ACCESS_TOKEN=

# ─── Resend (wachtwoord-reset e-mails via Supabase SMTP) ─────────────────────
#
# Lokaal: [auth.email.smtp] staat AAN in supabase/config.toml → Supabase CLI leest
# deze variabelen uit project-root .env bij `supabase start` (env()-substitutie).
# Inbucket (:54324) draait nog maar wordt overgeslagen zolang SMTP enabled=true.
#
# RESEND SETUP (Resend Dashboard — resend.com)
#   1. Domain toevoegen en DNS verifiëren (SPF, DKIM, DMARC)
#   2. API Keys → Create → kopieer sleutel (re_…)
#   3. Sender: bijv. noreply@jouwdomein.nl (moet op geverifieerd domein staan)
#
# Lokaal vereist (niet committen):
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
FEEDBACK_TO_EMAIL=info@jouwdomein.nl

# Na invullen: supabase stop && supabase start  (of: npm run supabase:restart)
#
# TESTEN (lokaal Resend)
#   1. Vul RESEND_API_KEY + RESEND_SENDER_EMAIL hierboven in
#   2. supabase stop && supabase start
#   3. Start app tegen lokale Supabase (EXPO_PUBLIC_SUPABASE_URL = http://<IP>:54321)
#   4. Forgot password → vul je echte e-mail in
#   5. Resend Dashboard → Emails (delivery status)
#   6. Open reset-link op device → faithapp://reset-password
#
# Productie (Supabase Dashboard SMTP — niet in app .env):
#   Host: smtp.resend.com | Port: 587 | User: resend | Pass: Resend API key
#   Sender email: zelfde als RESEND_SENDER_EMAIL | Sender name: Faith Generation
#   Auth → URL Configuration: faithapp://** in additional redirect URLs
#   Auth → Email Templates → Reset Password: HTML uit supabase/templates/recovery.html
#
# ─── Edge Function: send-feedback (app-feedback via Resend) ───────────────────
#
# Lokaal: edge_runtime.secrets in supabase/config.toml leest RESEND_API_KEY,
# RESEND_SENDER_EMAIL en FEEDBACK_TO_EMAIL uit project-root .env bij supabase start.
#
# Productie deploy:
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set RESEND_SENDER_EMAIL=noreply@...
#   supabase secrets set FEEDBACK_TO_EMAIL=info@...
#   supabase functions deploy send-feedback
#
# Lokaal testen:
#   1. Vul RESEND_API_KEY, RESEND_SENDER_EMAIL, FEEDBACK_TO_EMAIL in .env
#   2. supabase stop && supabase start
#   3. Invoke via app (ingelogd) of curl met JWT Authorization header
#
# ─── GitHub Actions / productie deploy ───────────────────────────────────────
#
# Deze secrets horen NIET in lokale .env — zet ze in GitHub:
#   Settings → Environments → production → Environment secrets
#
# Eenmalig vóór eerste deploy-run: maak environment "production" aan en voeg toe:
#
#   SUPABASE_ACCESS_TOKEN   Personal Access Token (Supabase Dashboard → Account → Access Tokens)
#                           Gebruik: supabase link, functions deploy, auth template PATCH
#   SUPABASE_PROJECT_REF    Project reference (Dashboard → Project Settings → General)
#                           Gebruik: alle Supabase deploy-jobs in deploy-production.yml
#   SUPABASE_DB_PASSWORD    Database password (Dashboard → Project Settings → Database)
#                           Gebruik: supabase db push na link
#
# Auth recovery template deploy (bij wijziging supabase/templates/recovery.html
# of recovery subject in supabase/config.toml):
#   node scripts/deploy-auth-templates.mjs
#   (workflow zet SUPABASE_ACCESS_TOKEN + SUPABASE_PROJECT_REF automatisch)
#
# Edge function secrets (RESEND_*, FEEDBACK_TO_EMAIL) blijven handmatig via
# supabase secrets set — niet via GitHub Actions.
